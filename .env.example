# ============================================================
# IEEE Citation Workflow — Configuration Template
# Copy this file to .env and fill in your values
# ============================================================
# HOW TO FILL THIS FILE:
#
# STEP 1 — ZOTERO API KEY
#   1. Go to: https://www.zotero.org/settings/keys
#   2. Click "Create new private key"
#   3. Name it: ieee-citation-workflow
#   4. Under Permissions, check: Allow library access (Read Only)
#   5. Click "Save Key" — copy the long key string below
#
# STEP 2 — ZOTERO USER ID
#   1. Go to: https://www.zotero.org/settings/keys
#   2. Your numeric User ID is shown at the TOP of that page
#      (before the key list) — it looks like: 1234567
#   3. Paste ONLY the number below (no spaces)
#
# STEP 3 — YOUR EMAIL (for Crossref)
#   Used to identify your requests politely to Crossref API.
#   Crossref is free — this just improves your request priority.
# ============================================================

ZOTERO_API_KEY=your_zotero_api_key_here
ZOTERO_USER_ID=your_numeric_user_id_here
ZOTERO_LIBRARY_TYPE=user
CROSSREF_EMAIL=your_email@example.com

# ── Server settings (change only if port 8080 is taken) ──────
UPLOAD_FOLDER=uploads
OUTPUT_FOLDER=outputs
LOG_FOLDER=logs
PORT=8080
MAX_FILE_SIZE_MB=50

# ── n8n webhook (leave default if using local n8n) ────────────
N8N_WEBHOOK_URL=http://localhost:5678/webhook/ieee-citation-workflow
